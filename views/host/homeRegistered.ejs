<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Added</title>
    <link rel="stylesheet" href="/output.css"/>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center">
    <div class="bg-white shadow-md rounded-lg p-8 max-w-md w-full text-center">
        <header class="mb-4">
            <h1 class="text-2xl font-bold text-red-700">Home Registered Successfully</h1>
        </header>
        <main class="space-y-2">
            <p class="italic text-green-600">
                "<%= home.name %>" has been successfully registered on Airbnb.
            </p>
            <p class="text-orange-600">Thank you for choosing our platform to list your property.</p>
            <a href="/" class="inline-block mt-4 bg-red-600 hover:bg-red-700 text-white font-semibold px-4 py-2 rounded-lg transition">
                Go to Home
            </a>
        </main>
    </div>
</body>
</html>