<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Home - airbnb</title>
    <link rel="stylesheet" href="/output.css"/>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center">
    <div class="bg-white shadow-md rounded-lg p-8 max-w-md w-full">
        <header class="mb-6 text-center">
            <h1 class="text-2xl font-bold text-red-600">Edit Your Home</h1>
        </header>
        <main>
            <form action="/host/edit-home/<%= home._id %>" method="POST" class="space-y-4">
                <input type="text" name="name" value="<%= home.houseName %>" placeholder="Enter your house name"
                       class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-400"/>
                <input type="text" name="location" value="<%= home.location %>" placeholder="Enter your address"
                       class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-400"/>
                <input type="text" name="price" value="<%= home.price %>" placeholder="Enter your price per night"
                       class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-400"/>
                <input type="text" name="image" value="<%= home.imageURL %>" placeholder="Enter your image url"
                       class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-400"/>
                <input type="text" name="rating" value="<%= home.rating %>" placeholder="Give Rating upto 5"
                       class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-400"/>
                <input type="submit" value="Update Home"
                       class="w-full bg-red-600 hover:bg-red-700 text-white font-semibold py-2 rounded-lg transition cursor-pointer"/>
            </form>
        </main>
    </div>
</body>
</html>