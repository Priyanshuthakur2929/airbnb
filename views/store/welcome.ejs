<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Airbnb — Find Your Stay</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-25px) rotate(8deg); }
        }
        @keyframes floatSlow {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(20px) rotate(-6deg); }
        }
        .blob1 { animation: float 7s ease-in-out infinite; }
        .blob2 { animation: floatSlow 9s ease-in-out infinite; }
        .blob3 { animation: float 5.5s ease-in-out infinite; }
        .card-3d {
            transform: perspective(1000px) rotateX(2deg);
            box-shadow: 0 25px 60px -12px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.1);
        }
    </style>
</head>
<body class="min-h-screen bg-gradient-to-br from-purple-600 via-pink-500 to-orange-400 overflow-hidden relative flex items-center justify-center px-4">

    <!-- floating decorative blobs -->
    <div class="blob1 absolute top-10 left-10 w-32 h-32 bg-yellow-300 rounded-full opacity-40 blur-2xl"></div>
    <div class="blob2 absolute bottom-16 right-16 w-48 h-48 bg-blue-400 rounded-full opacity-30 blur-3xl"></div>
    <div class="blob3 absolute top-1/3 right-1/4 w-24 h-24 bg-pink-300 rounded-full opacity-40 blur-2xl"></div>
    <div class="blob2 absolute bottom-1/4 left-1/4 w-20 h-20 bg-green-300 rounded-full opacity-30 blur-2xl"></div>

    <div class="relative z-10 w-full max-w-md">
        <div class="text-center mb-6">
            <h1 class="text-4xl font-extrabold text-white drop-shadow-lg">airbnb</h1>
            <p class="text-white/90 mt-2 text-lg">Find Your Perfect Stay</p>
        </div>

        <div class="card-3d bg-white/95 backdrop-blur rounded-3xl p-8">
            <h2 class="text-2xl font-bold text-gray-900 text-center mb-1">Welcome</h2>
            <p class="text-gray-500 text-center mb-6 text-sm">Log in to continue</p>

            <form action="/login" method="POST" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                    <input type="email" name="email" required
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-pink-500 focus:border-transparent outline-none transition"
                        placeholder="you@example.com">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                    <input type="password" name="password" required
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-pink-500 focus:border-transparent outline-none transition"
                        placeholder="••••••••">
                </div>
                <button type="submit"
                    class="w-full bg-gradient-to-r from-pink-500 to-orange-400 hover:from-pink-600 hover:to-orange-500 text-white font-semibold py-3 rounded-xl transition shadow-lg">
                    Log In
                </button>
            </form>

            <div class="flex items-center gap-3 my-6">
                <div class="flex-1 h-px bg-gray-200"></div>
                <span class="text-xs text-gray-400">or</span>
                <div class="flex-1 h-px bg-gray-200"></div>
            </div>

            <a href="/homelist"
               class="block text-center w-full border-2 border-gray-900 text-gray-900 font-semibold py-3 rounded-xl hover:bg-gray-900 hover:text-white transition">
                🏠 Continue as Guest — Home
            </a>

            <p class="text-center text-sm text-gray-500 mt-6">
                No account? <a href="/sign-up" class="text-pink-600 font-semibold hover:underline">Sign up</a>
            </p>
        </div>
    </div>

</body>
</html>