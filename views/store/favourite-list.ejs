<%- include('../partials/header')%>
<%- include('../partials/navbar')%>

<main class="max-w-5xl mx-auto mt-8 px-4">
    <h2 class="text-2xl font-bold text-red-700 text-center">Favourites</h2>
    <p class="text-lg text-gray-600 text-center">Here are your favourite Homes</p>

    <div class="flex justify-between items-center mb-6 mt-6">
        <h2 class="text-orange-600 font-bold text-2xl">Registered Homes</h2>
    </div>

    <% if (homeRegistered.length > 0) { %>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6">
            <% homeRegistered.forEach(home => { %>
                <div class="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-lg transition">
                    <img src="<%= home.imageURL %>" alt="<%= home.houseName %>"
                         onerror="this.onerror=null; this.src='/default-home.jpg'"
                         class="w-full aspect-[3/4] object-cover"/>

                    <div class="p-4">
                        <p class="font-semibold text-gray-900 text-lg"><%= home.houseName %></p>
                        <p class="text-sm text-gray-500 mt-1"><%= home.location %></p>
                        <div class="flex justify-between items-center mt-3">
                            <p class="font-bold text-gray-900">
                                $<%= home.price %> <span class="font-normal text-gray-500 text-sm">/ night</span>
                            </p>
                            <p class="flex items-center gap-1 text-sm font-semibold text-gray-800">
                                <span class="text-yellow-400">★</span> <%= home.rating %>
                            </p>
                        </div>

                        <form action="/favourite-list/remove" method="POST">
                            <input type="hidden" name="name" value="<%= home.houseName %>">
                            <button type="submit" class="bg-red-500 hover:bg-red-700 text-white font-semibold px-4 py-2 rounded-lg transition mt-2">
                                - Remove
                            </button>
                        </form>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <p class="text-gray-400 text-center py-4">No favourite homes yet.</p>
    <% } %>
</main>

<%- include('../partials/footer')%>